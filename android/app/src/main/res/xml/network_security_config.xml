<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development configuration -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
    </domain-config>

    <!-- Production configuration - HTTPS only for public domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">honeyvision.in</domain>
        <domain includeSubdomains="true">www.honeyvision.in</domain>
        <domain includeSubdomains="true">api.honeyvision.in</domain>
    </domain-config>

    <!-- Trust system certificates -->
    <trust-anchors>
        <certificates src="system" />
        <certificates src="user" />
    </trust-anchors>
</network-security-config>
