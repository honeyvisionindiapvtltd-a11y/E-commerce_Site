AI_PROVIDER=openai
AI_API_KEY=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
