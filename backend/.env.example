PORT=5000
RAZORPAY_ENABLED=false
RAZORPAY_WEBHOOKS_ENABLED=false
# Comma-separated browser origins. Add the current Quick Tunnel frontend URL when testing on mobile.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://192.168.31.5:5173,https://YOUR-FRONTEND-TUNNEL.trycloudflare.com
# Cloudflare Quick Tunnel example:
# FRONTEND_URL=https://YOUR-FRONTEND-TUNNEL.trycloudflare.com
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
RETURN_WINDOW_DAYS=7

# Delivery OTP and invoice email
EMAIL_SERVICE=gmail
EMAIL_USER=your-sender@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@honeyvision.in
EMAIL_CC=support@honeyvision.in
HONEYVISION_OFFICE_NAME=HoneyVision India Pvt. Ltd.
HONEYVISION_OFFICE_ADDRESS=Rukmani Plaza, Lane-1, Kendriya Vihar, Bhubaneswar, Odisha 752054
HONEYVISION_OFFICE_CITY=Bhubaneswar
HONEYVISION_OFFICE_STATE=Odisha
HONEYVISION_OFFICE_COUNTRY=India
HONEYVISION_OFFICE_PINCODE=752054
HONEYVISION_OFFICE_LAT=20.227943339878575
HONEYVISION_OFFICE_LNG=85.7356197134927

# Delivery OTP SMS (2Factor)
TWO_FACTOR_API_KEY=your-2factor-api-key
TWO_FACTOR_TEMPLATE_NAME=HoneyVision OTP
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_TIMEOUT_MS=10000

# OTP is returned only when both conditions are explicitly enabled for local use.
NODE_ENV=development
ALLOW_DEV_OTP_EXPOSURE=false

