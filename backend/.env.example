PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# Delivery OTP and invoice email
EMAIL_SERVICE=gmail
EMAIL_USER=your-sender@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@honeyvision.in
EMAIL_CC=support@honeyvision.in

# Delivery OTP SMS (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
# Approved Twilio Content Template SID containing variable {{1}} for the OTP.
TWILIO_OTP_CONTENT_SID=
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_TIMEOUT_MS=10000

# OTP is returned only when both conditions are explicitly enabled for local use.
NODE_ENV=development
ALLOW_DEV_OTP_EXPOSURE=false